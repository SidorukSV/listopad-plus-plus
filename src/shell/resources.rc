#include <windows.h>
#include "listopad/version.h"

// MUIVerb uses this indirect string from the classic MSI fallback. Explorer
// selects the resource that matches the current Windows UI language.
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
STRINGTABLE
BEGIN
  101 "Open in Listopad++"
END

LANGUAGE LANG_RUSSIAN, SUBLANG_RUSSIAN_RUSSIA
STRINGTABLE
BEGIN
  101 "Открыть в Listopad++"
END

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

VS_VERSION_INFO VERSIONINFO
 FILEVERSION LISTOPAD_VERSION_MAJOR,LISTOPAD_VERSION_MINOR,LISTOPAD_VERSION_PATCH,0
 PRODUCTVERSION LISTOPAD_VERSION_MAJOR,LISTOPAD_VERSION_MINOR,LISTOPAD_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Listopad++ Contributors"
      VALUE "FileDescription", "Listopad++ File Explorer command"
      VALUE "FileVersion", LISTOPAD_VERSION_STRING
      VALUE "InternalName", "ListopadShell"
      VALUE "OriginalFilename", "ListopadShell.dll"
      VALUE "ProductName", "Listopad++"
      VALUE "ProductVersion", LISTOPAD_VERSION_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
