#include <windows.h>
#include "resource.h"
#include "listopad/version.h"

// Keep the localized classic context-menu caption in the main executable.
// Explorer resolves this indirect string using the current Windows UI language.
#pragma code_page(65001)

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
STRINGTABLE
BEGIN
  IDS_CONTEXT_MENU_OPEN "Open in Listopad++"
END

LANGUAGE LANG_RUSSIAN, SUBLANG_RUSSIAN_RUSSIA
STRINGTABLE
BEGIN
  IDS_CONTEXT_MENU_OPEN "Открыть в Listopad++"
END

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

// Subset of the Phosphor icon font (MIT, see assets/Phosphor-LICENSE.txt),
// trimmed to just the toolbar glyphs and loaded privately at runtime.
IDR_PHOSPHOR_FONT RCDATA "assets/Phosphor-Subset.ttf"

IDD_SETTINGS DIALOGEX 0, 0, 430, 336
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Настройки Listopad++"
FONT 9, "Segoe UI"
BEGIN
  GROUPBOX "Интерфейс и редактор", -1, 8, 7, 414, 157
  LTEXT "Язык интерфейса:", -1, 18, 22, 100, 10
  COMBOBOX IDC_SETTINGS_LANGUAGE, 126, 19, 132, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  LTEXT "Тема:", -1, 18, 43, 100, 10
  COMBOBOX IDC_SETTINGS_THEME, 126, 40, 132, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  LTEXT "Шрифт:", -1, 18, 64, 100, 10
  EDITTEXT IDC_SETTINGS_FONT_FACE, 126, 61, 132, 14, ES_AUTOHSCROLL
  LTEXT "Размер шрифта (7–40):", -1, 272, 64, 104, 10
  EDITTEXT IDC_SETTINGS_FONT_SIZE, 376, 61, 34, 14, ES_NUMBER
  LTEXT "Отступ (1–8):", -1, 18, 85, 100, 10
  EDITTEXT IDC_SETTINGS_INDENT_SIZE, 126, 82, 34, 14, ES_NUMBER
  AUTOCHECKBOX "Использовать табуляцию", IDC_SETTINGS_INDENT_TABS, 176, 83, 138, 12
  AUTOCHECKBOX "Показывать карту документа", IDC_SETTINGS_DOCUMENT_MAP, 18, 104, 180, 12
  LTEXT "Резервная кодировка:", -1, 18, 127, 100, 10
  COMBOBOX IDC_SETTINGS_FALLBACK_ENCODING, 126, 124, 132, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  LTEXT "Большой файл, МиБ:", -1, 272, 127, 104, 10
  EDITTEXT IDC_SETTINGS_LARGE_FILE_MB, 376, 124, 34, 14, ES_NUMBER

  GROUPBOX "Сеанс и восстановление", -1, 8, 170, 414, 105
  AUTOCHECKBOX "Сохранять аварийные копии", IDC_SETTINGS_RECOVERY_ENABLED, 18, 186, 176, 12
  AUTOCHECKBOX "Восстанавливать прошлый сеанс", IDC_SETTINGS_RESTORE_SESSION, 214, 186, 190, 12
  LTEXT "Максимум копии, МиБ (1–128):", -1, 18, 209, 158, 10
  EDITTEXT IDC_SETTINGS_RECOVERY_MAX_MB, 176, 206, 38, 14, ES_NUMBER
  LTEXT "Хранить, дней (1–30):", -1, 230, 209, 120, 10
  EDITTEXT IDC_SETTINGS_RETENTION_DAYS, 356, 206, 38, 14, ES_NUMBER
  PUSHBUTTON "Очистить recovery", IDC_SETTINGS_CLEAR_RECOVERY, 18, 238, 116, 18
  PUSHBUTTON "Очистить сеанс", IDC_SETTINGS_CLEAR_SESSION, 146, 238, 116, 18
  PUSHBUTTON "Очистить историю", IDC_SETTINGS_CLEAR_HISTORY, 274, 238, 116, 18

  DEFPUSHBUTTON "ОК", IDOK, 194, 307, 68, 21
  PUSHBUTTON "Отмена", IDCANCEL, 270, 307, 68, 21
  PUSHBUTTON "Применить", IDC_SETTINGS_APPLY, 346, 307, 76, 21
END

IDD_RECOVERY DIALOGEX 0, 0, 430, 250
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Восстановление Listopad++"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "Предыдущий сеанс завершился неожиданно. Выберите документы для восстановления:", IDC_RECOVERY_DESCRIPTION, 10, 10, 410, 24
  LISTBOX IDC_RECOVERY_LIST, 10, 38, 410, 166, LBS_EXTENDEDSEL | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | WS_BORDER
  DEFPUSHBUTTON "Восстановить выбранные", IDOK, 126, 218, 132, 22
  PUSHBUTTON "Удалить все", IDC_RECOVERY_DELETE_ALL, 266, 218, 76, 22
  PUSHBUTTON "Выйти", IDCANCEL, 350, 218, 70, 22
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION LISTOPAD_VERSION_MAJOR,LISTOPAD_VERSION_MINOR,LISTOPAD_VERSION_PATCH,0
 PRODUCTVERSION LISTOPAD_VERSION_MAJOR,LISTOPAD_VERSION_MINOR,LISTOPAD_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Listopad++ Contributors"
      VALUE "FileDescription", "Fast offline text editor"
      VALUE "FileVersion", LISTOPAD_VERSION_STRING
      VALUE "InternalName", "ListopadPP"
      VALUE "OriginalFilename", "ListopadPP.exe"
      VALUE "ProductName", "Listopad++"
      VALUE "ProductVersion", LISTOPAD_VERSION_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
